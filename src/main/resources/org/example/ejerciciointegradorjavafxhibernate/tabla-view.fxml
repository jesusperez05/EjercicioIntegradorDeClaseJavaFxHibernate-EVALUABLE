<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ejerciciointegradorjavafxhibernate.TablaController">
    <center>
        <VBox alignment="CENTER" maxWidth="445.0" prefHeight="340.0" prefWidth="445.0" spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0">
                <columns>
                    <TableColumn fx:id="cId" prefWidth="75.0" text="Id" />
                    <TableColumn fx:id="cName" prefWidth="75.0" text="Nombre" />
                    <TableColumn fx:id="cCategory" prefWidth="75.0" text="Categoria" />
                    <TableColumn fx:id="cAvailability" prefWidth="75.0" text="Disponibilidad" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
